# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a key at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Model used by the agentic loop. Keep Haiku while developing; it is roughly
# 5x cheaper than Opus per output token.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
