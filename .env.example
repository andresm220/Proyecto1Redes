# Copy this file to .env and fill in the provider you intend to use.
# .env is git-ignored and must never be committed.

# Which model backend the agentic loop talks to.
#   anthropic          Anthropic Messages API (needs a funded account)
#   groq               Groq, OpenAI-compatible, hosts open-source models
#   openrouter         OpenRouter, OpenAI-compatible
#   ollama, lmstudio   a local runtime, no API key needed
#   openai_compatible  any other endpoint; set LLM_BASE_URL yourself
LLM_PROVIDER=groq

# --- anthropic -------------------------------------------------------------
# https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- groq ------------------------------------------------------------------
# https://console.groq.com -> API Keys
# Models that handle tool calling well, largest first. The free tier limits
# tokens per minute, and this project's seven tool schemas are large enough to
# trip that; the client waits out the limit and retries on its own.
#   openai/gpt-oss-120b   open weights, best tool use
#   qwen/qwen3.6-27b      open weights, lighter and faster
#   openai/gpt-oss-20b    open weights, fastest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- any other OpenAI-compatible endpoint ----------------------------------
# Only read when LLM_PROVIDER=openai_compatible. A local runtime needs no key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
